# Сэтгэлийн Одод — орчны тохиргоо. Энэ файлыг .env болгон хуулж утгуудаа оруулна.
# .env файлыг GitHub-д хэзээ ч оруулахгүй (.gitignore-д байгаа).

# PostgreSQL холболт (заавал)
DATABASE_URL=postgres://setgeliin:changeme@localhost:5432/setgeliin_odod

# Сессийн нууц (заавал, урт санамсаргүй утга)
SESSION_SECRET=change-me-to-a-long-random-string

# Серверийн порт (сонголттой, анхдагч 3001)
PORT=3001

# QPay merchant тохиргоо (сонголттой — хоосон бол туршилтын горим ажиллана)
# Бөглөсөн тохиолдолд админ самбарт оруулсан тохиргооноос давуу эрхтэй.
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_MERCHANT_ID=
# QPay API үндсэн хаяг (сонголттой)
QPAY_BASE_URL=https://merchant.qpay.mn/v2
